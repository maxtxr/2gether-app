
{
  "expo": {
    "name": "2gether",
    "slug": "2gether",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ipmgroupone.twogether",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#005238",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.ipmgroupone.twogether"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar",
      "expo-font",
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "-keep class * extends androidx.room.RoomDatabase { <init>(); }\n-keep class * extends androidx.work.InputMerger { <init>(); }"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "65ed9f5f-5ba7-4e2d-ba02-dcced678a5d4"
      }
    }
  }
}

